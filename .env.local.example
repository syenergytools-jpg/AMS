# ── Supabase ──────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret (NEVER expose to the browser). Used to create employee
# accounts and upload profile photos. Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email of the account that should be the first/super admin.
# After this user registers, they are automatically granted ADMIN role.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=admin@evolutecomsolutions.com

# ── Backblaze B2 (tracker desktop-app builds) ───────────────────────────────
# Only needed for the admin's Tracker upload page. B2's free tier (10GB, no
# credit card required) has no per-file size cap, unlike Cloudinary's free
# plan (10MB) or Supabase Storage (~50MB) — needed for the ~110MB installer.
# Setup: backblaze.com → sign up → B2 Cloud Storage → Create a Bucket (private
# is fine, downloads use time-limited signed URLs) → note its "Endpoint"
# (e.g. s3.us-west-004.backblazeb2.com) → Account → Application Keys →
# Add a New Application Key (scope it to that bucket) → copy the keyID and
# applicationKey it shows once.
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_ACCESS_KEY_ID=your-application-key-id
B2_SECRET_ACCESS_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name

# ── Resend (password-reset emails) ──────────────────────────────────────────
# Get this from: resend.com → API Keys. Used server-side only, to email a
# 6-digit reset code to an employee who forgot their password.
RESEND_API_KEY=your-resend-api-key
# Must be a verified sender on your Resend domain, e.g.
# "Evolut Attendance <noreply@yourdomain.com>" (or onboarding@resend.dev for
# testing before a custom domain is verified — only delivers to your own
# Resend account email in that case).
RESEND_FROM_EMAIL=Evolut Attendance <noreply@yourdomain.com>

# ── ZKTeco K50 fingerprint device sync (optional) ───────────────────────────
# Only needed on the machine running `npm run sync:zkteco` — see README.
# LAN IP address of the K50 (on the device: Menu -> COMM. -> Ethernet -> IP Address).
ZKTECO_DEVICE_IP=192.168.1.201
ZKTECO_DEVICE_PORT=4370
# Device's "Comm Key" password, if one was set in its menu. 0 = no password.
ZKTECO_COMM_KEY=0
# How often (seconds) to poll the device for new fingerprint punches.
ZKTECO_POLL_INTERVAL_SECONDS=60
# How many days of on-device history to consider on each poll.
ZKTECO_LOOKBACK_DAYS=2
